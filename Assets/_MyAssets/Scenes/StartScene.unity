  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "  D\xE9place Bowser librement dans l\u2019aire de jeu et fais tout pour
    \xE9viter les collisions.\n\n  C\u2019est \xE0 toi de contr\xF4ler ses mouvements
    pour qu\u2019il ne touche aucun obstacle. \n\n  Certains pi\xE8ges sont plac\xE9s
    \xE0 des endroits dangereux et d\u2019autres apparaissent au fur et \xE0 mesure,
    alors reste attentif et joue avec les  controles WASD pour se d\xE9placer. \n\n 
    Plus tu avances, plus l\u2019environnement devient difficile \xE0 traverser.
    \n\n  Garde Bowser en mouvement, observe bien autour de toi et essaie de survivre
    le plus longtemps possible sans jamais entrer en contact avec quoi que ce soit.\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2eec1435f4459b94e8e2ee18ecbac066, type: 2}
  m_sharedMaterial: {fileID: -3773975006940699062, guid: 2eec1435f4459b94e8e2ee18ecbac066, type: 2}
